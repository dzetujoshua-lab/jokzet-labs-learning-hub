{
  "name": "Department",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Stable code, e.g. fswd"
    },
    "name": {
      "type": "string"
    },
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Total XP earned in this department"
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "next_milestone": {
      "type": "string",
      "description": "The next practical proof of progress"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}