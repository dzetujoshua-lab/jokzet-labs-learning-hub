# Copy to .env (gitignored). Server-side only; never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jokzet_learning?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jokzet_learning_test?schema=public"

# --- Reminders / Web Push (server-side only, never NEXT_PUBLIC_) ---
# Generate with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret (24+ chars) protecting POST /api/cron/dispatch. Generate e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Optional: run the reminder scheduler inside the Next.js server process (single instance only)
ENABLE_IN_PROCESS_SCHEDULER=false
# Optional: extra allowed push-service hostnames, comma separated
PUSH_EXTRA_HOSTS=

# Evidence file storage directory (default: ./storage, outside public/). Back this up; never expose it statically.
STORAGE_DIR=
