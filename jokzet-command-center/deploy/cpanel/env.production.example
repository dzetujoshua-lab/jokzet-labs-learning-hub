# Environment variables for the cPanel "Setup Node.js App" page (Environment variables section).
# This file is documentation only: do NOT copy real values into it and do NOT commit real values anywhere.
# Names come from the code (src/ and scripts/); nothing here is invented.

# --- Required -----------------------------------------------------------------------------------------------------------
NODE_ENV=production
# Public address. Used for the CSRF origin check and Server Actions behind the proxy. Must be https.
APP_URL=https://jokzet-labs.iipghstudent.com
# The EXISTING Neon database, pooled connection string (host contains "-pooler"), with sslmode=require. Set it in the cPanel
# panel only. Never in Git, a file in the repository, a screenshot or a chat message.
DATABASE_URL=
# 24+ characters. Protects POST /api/cron/dispatch. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Uploads (evidence files) -------------------------------------------------------------------------------------------
# The Netlify blob store does not exist on cPanel. Use the local disk driver and a folder OUTSIDE the application folder, so a
# redeploy never deletes learner files. Back this folder up. Create it first: mkdir -p $HOME/jokzet-data/evidence
STORAGE_DRIVER=local
STORAGE_DIR=/home/CPANEL_USER/jokzet-data/evidence

# --- Client address for rate limiting (verify first) --------------------------------------------------------------------
# Number of reverse proxies you control in front of the app (LiteSpeed counts as one). Leave unset until you have checked what
# the server receives, because a wrong value weakens or breaks rate limiting. See README step 7.
# TRUSTED_PROXY_HOPS=1

# --- Reminders and Web Push ---------------------------------------------------------------------------------------------
# Generate once with: npm run push:keys (from a source checkout). Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR-PRIVACY-OR-ADMIN-ADDRESS
# Scheduler: use the cron job (install-cron.sh). Do not turn on the in-process scheduler as well.
ENABLE_IN_PROCESS_SCHEDULER=false

# --- Behaviour ----------------------------------------------------------------------------------------------------------
PRIVACY_CONTACT_EMAIL=jokzetlabs.privacy@gmail.com
# Leave PERSONALISED_LEARNING unset to keep the current behaviour (it is off in production today).
# ALLOW_REGISTRATION=false   # set to "false" to close sign-up

# --- DeepSeek assessment: NOT IMPLEMENTED YET -----------------------------------------------------------------------------
# These names are reserved by the approved architecture. The application does not read them today. Leave unset.
# DEEPSEEK_ENABLED=false
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_ASSESSMENT_MODEL=deepseek-flash
# DEEPSEEK_ADVANCED_MODEL=deepseek-v4-pro
